# Legacy engagement data (now stored in $GRIMNIR_WORKSPACE/$PROJECT/, default ~/workspace/)
engagements/

# Operator-local review/build reports — may reference real programs; never track (CLAUDE.md hygiene rule)
reports/

# Runtime and temp files
*.log
*.tmp
*.bak
*.swp
*~

# Tool output that may land in agent dirs
*.gnmap
*.nmap
*.xml
*.json.bak

# OS files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/

# IDE
.vscode/
.idea/
*.code-workspace

# Operator-specific config — fill from templates/, keep local
TEAM.md

# Claude Code's per-checkout local settings. It records ABSOLUTE paths into the
# operator's home ("/home/<user>/workspace/...") plus the Bash allow-list, so it is
# operator-specific by construction and must never be tracked. It was previously
# ignored only by the maintainer's GLOBAL git excludes (~/.config/git/ignore), which
# meant a fresh clone had no protection at all and the first `git add -A` would have
# committed it.
.claude/settings.local.json

# Sensitive files — never commit
*.env
.env.*
credentials.json
tokens.json
*.key
*.pem
*.p12

# Host-global store lives OUTSIDE the repo at ~/.grimnir/ (test journal, release data).
# These repo-relative guards only matter if someone points a cache dir at the repo (don't).
.grimnir/

# Large binary tools (installed via setup.sh, not stored in repo)
*.tar.gz
*.deb
*.rpm

# Operator planning notes live in ~/.grimnir/docs/, not in the repo.
docs/architecture-diagram.html

# Engagement-specific recon scratch — names real targets and/or hardcodes operator
# paths; never track. The GENERIC capability from these one-off scripts now lives in
# huginn/scripts/js-pipeline.sh (Wayback CDX recovery, config discovery).
#
# Two named one-offs (scripts/process-cdx.py, scripts/process-urlscan-paths.py) used to
# be listed here. Being ignored kept them out of git but left them in the tree, still
# carrying an absolute operator path and a real program name, one `git add -f` from
# publication. They were superseded by js-pipeline.sh and now live outside the repo.
# Ignoring a landmine is not the same as removing it.
_ls_recon/
tmp/
